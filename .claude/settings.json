{
	"permissions": {
		"allow": [
			"Bash(pnpm dev)",
			"Bash(pnpm build)",
			"Bash(pnpm preview)",
			"Bash(pnpm lint)",
			"Bash(pnpm lint:fix)",
			"Bash(pnpm format)",
			"Bash(pnpm format:check)",
			"Bash(pnpm typecheck)",
			"Bash(pnpm validate)",
			"Bash(pnpm install)",
			"Bash(pnpm add *)",
			"Bash(pnpm astro add *)",
			"Bash(pnpm dlx *)",
			"Bash(curl *)"
		],
		"deny": ["Bash(git push *)", "Bash(git remote *)"]
	},
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Write|Edit|MultiEdit",
				"hooks": [
					{
						"type": "command",
						"command": "pnpm lint:fix && pnpm format"
					}
				]
			}
		]
	}
}
