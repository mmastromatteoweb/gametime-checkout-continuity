---
import type { Session } from '@checkout/types';
import { HttpError } from '@checkout/client';
import { API_BASE_URL, serverApi } from '../../../lib/api.ts';
import OrderSummary from '../../../components/OrderSummary.astro';
import CheckoutIsland from '../../../components/CheckoutIsland.astro';
import '../../../styles/global.css';

export const prerender = false;

const { id } = Astro.params;
let session: Session | null = null;
let notFound = false;
if (id) {
	try {
		session = await serverApi().getSession(id);
	} catch (err) {
		if (err instanceof HttpError && err.status === 404) notFound = true;
		else throw err;
	}
}

const price = (n: number) => `$${n.toFixed(2)}`;
const remainingMs = session ? Math.max(0, Date.parse(session.expiresAt) - Date.now()) : 0;
const totalSeconds = Math.floor(remainingMs / 1000);
const mm = Math.floor(totalSeconds / 60);
const ss = String(totalSeconds % 60).padStart(2, '0');
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<title>Checkout · GameTime</title>
	</head>
	<body class="min-h-screen bg-neutral-950 text-neutral-100">
		{
			notFound || !session ? (
				<main class="mx-auto flex min-h-screen max-w-md flex-col items-center justify-center px-6 text-center">
					<h1 class="text-2xl font-semibold">Session not found</h1>
					<p class="mt-2 text-sm text-neutral-400">
						We couldn't find that checkout. It may have expired.
					</p>
					<a
						href="/"
						class="mt-6 rounded-full bg-brand px-5 py-2.5 text-sm font-semibold text-neutral-950"
					>
						Start over
					</a>
				</main>
			) : (
				<main
					data-state-container
					data-state={session.state}
					data-surface="mobile"
					class="mx-auto flex min-h-screen max-w-md flex-col px-5 pb-32 pt-[max(env(safe-area-inset-top),1rem)]"
				>
					<div
						data-countdown-banner
						class="fixed inset-x-0 top-0 z-20 border-b border-amber-500/40 bg-amber-500/15 px-5 py-3 text-center text-sm font-medium text-amber-100"
						hidden
					>
						<span>Hurry — hold expires in </span>
						<span data-countdown-banner-value class="tabular-nums font-semibold">0:00</span>.
					</div>
					<div
						data-degraded-banner
						class="fixed inset-x-0 top-0 z-10 border-b border-neutral-700/60 bg-neutral-800/90 px-5 py-3 text-center text-sm text-neutral-200 backdrop-blur"
						role="status"
						aria-live="polite"
						hidden
					>
						<p>Reconnecting… your hold is still valid.</p>
					</div>

					<header class="flex items-center justify-between py-2">
						<a href="/" class="-ml-2 flex items-center gap-1 p-2 text-sm text-neutral-300" aria-label="Back">
							<span aria-hidden="true" class="text-xl leading-none">‹</span>
							<span>Back</span>
						</a>
						<span class="text-sm font-semibold text-neutral-100">Checkout</span>
						<span class="w-10" aria-hidden="true"></span>
					</header>

					<section
						class="mt-4 rounded-2xl border border-neutral-800 bg-neutral-900 p-5 text-center"
						aria-label="Hold timer"
					>
						<p class="text-[11px] font-semibold uppercase tracking-wider text-neutral-400">
							Hold expires in
						</p>
						<div
							data-countdown
							data-expires-at={session.expiresAt}
							class="mt-2 inline-flex items-center justify-center"
						>
							<time
								datetime={session.expiresAt}
								data-countdown-display
								aria-live="polite"
								class="text-4xl font-semibold tabular-nums text-neutral-100"
							>
								{mm}:{ss}
							</time>
						</div>
					</section>

					<section class="mt-4" aria-label="Event">
						<p class="text-lg font-semibold">{session.listing.eventName}</p>
						<p class="text-sm text-neutral-400">{session.listing.venue}</p>
					</section>

					<div class="mt-4">
						<OrderSummary session={session} />
					</div>

					{
						session.state === 'failed' && (
							<div
								class="mt-4 rounded-xl border border-red-500/40 bg-red-500/10 p-4 text-sm text-red-100"
								role="alert"
							>
								<p class="font-semibold">Payment couldn't go through.</p>
								{session.lastError && <p class="mt-1 opacity-80">{session.lastError}</p>}
							</div>
						)
					}

					{
						session.state === 'completed' && (
							<section
								class="mt-4 rounded-xl border border-brand/40 bg-brand/10 p-5 text-center"
								aria-live="polite"
							>
								<p class="text-2xl font-semibold text-brand">You're in.</p>
								<p class="mt-2 text-sm text-neutral-200">
									{session.listing.eventName}
								</p>
								<p class="mt-1 text-sm text-neutral-400">
									Section {session.listing.section} · Row {session.listing.row} · Qty{' '}
									{session.listing.quantity}
								</p>
								<p class="mt-3 text-xs text-neutral-500">Order #{session.id.slice(0, 8)}</p>
							</section>
						)
					}

					{
						session.state === 'expired' && (
							<section
								class="mt-4 rounded-xl border border-neutral-700 bg-neutral-900 p-5 text-center"
								aria-live="polite"
							>
								<p class="text-xl font-semibold">Your hold expired.</p>
								<p class="mt-2 text-sm text-neutral-400">
									The seats you held — Section {session.listing.section} / Row {session.listing.row}{' '}
									— were released.
								</p>
								<a
									href="/"
									class="mt-5 inline-block rounded-full bg-brand px-5 py-2.5 text-sm font-semibold text-neutral-950"
								>
									Start over
								</a>
							</section>
						)
					}

					<section
						class="mt-4 rounded-2xl border border-neutral-800 bg-neutral-900 p-5"
						aria-label="Payment"
					>
						<h2 class="text-[11px] font-semibold uppercase tracking-wider text-neutral-400">
							Payment
						</h2>
						<form class="mt-4 space-y-3">
							<label class="block">
								<span class="block text-[10px] font-medium uppercase tracking-wider text-neutral-500">
									Card number
								</span>
								<input
									type="text"
									value="•••• •••• •••• 4092"
									readonly
									class="mt-1 w-full rounded-md border border-neutral-800 bg-neutral-950 px-3 py-2.5 text-sm text-neutral-100 tabular-nums"
								/>
							</label>
							<div class="grid grid-cols-2 gap-3">
								<label class="block">
									<span class="block text-[10px] font-medium uppercase tracking-wider text-neutral-500">
										Expiration
									</span>
									<input
										type="text"
										value="08/28"
										readonly
										class="mt-1 w-full rounded-md border border-neutral-800 bg-neutral-950 px-3 py-2.5 text-sm text-neutral-100 tabular-nums"
									/>
								</label>
								<label class="block">
									<span class="block text-[10px] font-medium uppercase tracking-wider text-neutral-500">
										Security code
									</span>
									<input
										type="text"
										value="982"
										readonly
										class="mt-1 w-full rounded-md border border-neutral-800 bg-neutral-950 px-3 py-2.5 text-sm text-neutral-100 tabular-nums"
									/>
								</label>
							</div>
							<p class="pt-1 text-xs text-neutral-500">alex.morrison@example.com</p>
						</form>
					</section>

					{/* Bottom-anchored CTA pinned via fixed positioning + safe-area padding. */}
					<div
						class="fixed inset-x-0 bottom-0 z-30 border-t border-neutral-800 bg-neutral-950/95 px-5 pb-[max(env(safe-area-inset-bottom),1rem)] pt-4 backdrop-blur"
					>
						<p data-error-line role="alert" class="mb-2 min-h-4 text-center text-xs text-red-300">
							{session.lastError ?? ''}
						</p>
						<button
							type="button"
							data-accept-price
							class="mb-2 w-full rounded-full bg-brand px-5 py-3 text-sm font-semibold text-neutral-950"
							hidden={session.state !== 'price_changed'}
						>
							Accept new price ({price(session.currentPrice)})
						</button>
						<button
							type="button"
							data-cta
							class="w-full rounded-full bg-brand px-5 py-4 text-base font-semibold text-neutral-950 disabled:opacity-40"
							disabled={session.state !== 'active'}
						>
							{
								session.state === 'completed'
									? 'Completed'
									: session.state === 'payment_pending'
										? 'Processing…'
										: session.state === 'failed'
											? 'Try again'
											: session.state === 'expired'
												? 'Hold expired'
												: `Tap to complete · ${price(session.currentPrice)}`
							}
						</button>
					</div>

					<CheckoutIsland session={session} apiBaseUrl={API_BASE_URL} />
				</main>
			)
		}
	</body>
</html>
