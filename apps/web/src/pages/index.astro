---
import type { SessionState } from '@checkout/types';
import { newIdempotencyKey } from '@checkout/client';

const state: SessionState = 'active';
const sampleKey = newIdempotencyKey();
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<title>Checkout Continuity</title>
	</head>
	<body>
		<main>
			<h1>Checkout continuity scaffold</h1>
			<p>state: {state}</p>
			<p>sample idempotency key: {sampleKey}</p>
		</main>
	</body>
</html>
