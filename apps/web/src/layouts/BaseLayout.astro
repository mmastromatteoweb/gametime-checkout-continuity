---
import '../styles/global.css';
type Props = { title?: string };
const { title = 'Checkout · GameTime' } = Astro.props as Props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
	</head>
	<body class="min-h-screen">
		<slot />
	</body>
</html>
