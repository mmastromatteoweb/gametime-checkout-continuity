---
import type { Session } from '@checkout/types';

type Props = { session: Session };
const { session } = Astro.props as Props;
const price = (n: number) => `$${n.toFixed(2)}`;
const priceChanged = session.state === 'price_changed';
const delta = session.currentPrice - session.reservedPrice;
---

<section
	class="rounded-xl border border-neutral-800 bg-neutral-900 p-6 shadow-sm"
	aria-label="Order summary"
>
	<h2 class="text-sm font-semibold uppercase tracking-wider text-neutral-400">Order summary</h2>
	<p class="mt-3 text-xl font-semibold text-neutral-100" data-testid="event-name">
		{session.listing.eventName}
	</p>
	<p class="text-sm text-neutral-400">{session.listing.venue}</p>
	<p class="mt-3 grid grid-cols-3 gap-3 rounded-lg bg-neutral-950 p-3 text-center text-sm">
		<span>
			<span class="block text-[11px] uppercase tracking-wider text-neutral-500">Section</span>
			<span class="font-semibold text-neutral-100">{session.listing.section}</span>
		</span>
		<span>
			<span class="block text-[11px] uppercase tracking-wider text-neutral-500">Row</span>
			<span class="font-semibold text-neutral-100">{session.listing.row}</span>
		</span>
		<span>
			<span class="block text-[11px] uppercase tracking-wider text-neutral-500">Seats</span>
			<span class="font-semibold text-neutral-100">{session.listing.quantity}</span>
		</span>
	</p>

	{
		priceChanged && (
			<div
				class="mt-4 rounded-lg border border-amber-500/40 bg-amber-500/10 p-3 text-sm text-amber-100"
				role="status"
				aria-live="polite"
			>
				<p>
					Price changed. Was <s class="opacity-70">{price(session.reservedPrice)}</s>, now
					<strong class="text-emerald-300">{price(session.currentPrice)}</strong>
					{delta > 0 ? ` (+${price(delta)})` : null}.
				</p>
			</div>
		)
	}

	<dl class="mt-5 space-y-1 text-sm">
		<div class="flex justify-between text-neutral-400">
			<dt>Subtotal</dt>
			<dd data-testid="reserved-price">{price(session.reservedPrice)}</dd>
		</div>
		<div class="flex justify-between text-neutral-400">
			<dt>Fees</dt>
			<dd>included</dd>
		</div>
	</dl>
	<div class="mt-4 border-t border-neutral-800 pt-4">
		<div class="flex items-end justify-between">
			<div>
				<p class="text-sm font-semibold uppercase tracking-wider text-neutral-400">Total due</p>
				<p class="text-xs text-neutral-500">All fees included · USD</p>
			</div>
			<p
				class="text-3xl font-semibold tabular-nums text-emerald-300"
				data-testid="current-price"
			>
				{price(session.currentPrice)}
			</p>
		</div>
	</div>
</section>
